<Window x:Class="MyToDoWidget.MemoEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="메모" Width="580" Height="740" MinWidth="420" MinHeight="520"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
 Background="{DynamicResource PanelBrush}" Closing="Window_Closing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="EditorBoolVisibility"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}"/>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FormComboBoxItem}"/>
  <Style TargetType="DatePicker" BasedOn="{StaticResource FormDatePicker}"/>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,8">
  <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="KindBox" SelectionChanged="Kind_Changed" AutomationProperties.Name="메모 또는 일정"><ComboBoxItem Content="메모"/><ComboBoxItem Content="일정"/></ComboBox>
   <TextBlock x:Name="EditorHint" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
   <Button Grid.Column="2" Content="붙여넣기" Click="Paste_Click" Padding="10,2"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="제목 (선택)" VerticalAlignment="Center"/>
   <TextBox x:Name="TitleBox" Grid.Column="1" MaxLength="200" ToolTip="비우면 본문의 첫 줄을 사용합니다."/>
  </Grid>
  <Grid x:Name="DatePanel" Grid.Row="2" Margin="0,0,0,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
   <TextBlock Text="본문 인식 날짜·시각" FontSize="11" VerticalAlignment="Center"/>
   <TextBlock x:Name="RecognizedDate" Grid.Column="1" VerticalAlignment="Center" Foreground="#17617B"/>
   <TextBlock x:Name="RecognizedTime" Grid.Column="2" VerticalAlignment="Center" Foreground="#17617B"/>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,8,0,4">
   <ItemsControl x:Name="RecognizedTags" Margin="0,0,0,5" MaxHeight="58"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate><Border Background="#EAF3F8" CornerRadius="4" Padding="5,2" Margin="0,0,4,3"><TextBlock Text="{Binding StringFormat='#{0}'}" Foreground="{DynamicResource EditorTagBrush}" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="TokenKindBox" SelectedValuePath="Tag" SelectedIndex="0" ToolTip="입력할 정보 선택">
     <ComboBoxItem Content="태그 #" Tag="Tag"/><ComboBoxItem Content="날짜 !" Tag="Date"/><ComboBoxItem Content="시각 !" Tag="Time"/><ComboBoxItem Content="출처 @" Tag="Source"/><ComboBoxItem Content="링크 >" Tag="Link"/>
    </ComboBox>
    <TextBox x:Name="TokenInputBox" Grid.Column="1" Margin="8,0" PreviewKeyDown="TokenInput_KeyDown" ToolTip="내용만 입력하고 Enter · 여러 태그는 띄어 쓰기" MaxLength="2048"/>
    <Button Grid.Column="2" Content="넣기" Click="InsertToken_Click" Padding="10,2"/>
   </Grid>
   <TextBlock Text="분류·날짜 등은 위 칸에 내용만 넣고 Enter. 본문에 기호를 붙여 넣습니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,3" TextWrapping="Wrap"/>
   <TextBlock x:Name="MetadataHint" FontSize="11" Foreground="#17617B" TextWrapping="Wrap"/>
  </StackPanel>
  <TextBox x:Name="BodyBox" Grid.Row="3" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Padding="8,3" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="16"
   Height="180" MinHeight="130" MaxLength="40000" AutomationProperties.Name="자유 메모 또는 일정 세부 내용" SpellCheck.IsEnabled="False" TextChanged="Body_Changed"/>
  <StackPanel Grid.Row="5" Margin="0,5,0,0">
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="항목 배경" VerticalAlignment="Center"/>
    <ComboBox x:Name="CardColorCombo" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="CardColor_Changed"/>
    <TextBox x:Name="CardColorHex" Grid.Column="2" Margin="6,0" MaxLength="7" TextChanged="CardColorText_Changed" ToolTip="비우면 공통색 · #RRGGBB 사용자 색상"/>
    <Button Grid.Column="3" Content="색상…" Click="CardColor_Click" Padding="8,2"/>
   </Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <CheckBox x:Name="ReminderCheck" Content="별도 알림 사용"/>
    <CheckBox x:Name="CompletedCheck" Grid.Column="1" Content="완료한 항목"/>
   </Grid>
   <Grid Margin="0,5,0,0" Visibility="{Binding IsChecked, ElementName=ReminderCheck, Converter={StaticResource EditorBoolVisibility}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
    <DatePicker x:Name="ReminderDatePicker" SelectedDateFormat="Short" AutomationProperties.Name="알림 날짜"/>
    <TextBox x:Name="ReminderTimeBox" Grid.Column="1" Margin="8,0,0,0" MaxLength="5" ToolTip="알림 시각 HH:mm"/>
   </Grid>
   <TextBlock x:Name="TimeZoneHint" FontSize="10" LineHeight="15" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="6" Margin="0,7,0,7">
   <Grid Margin="0,0,0,5">
    <Grid.Resources><Style x:Key="MarkerCell" TargetType="TextBlock">
     <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
     <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,3,8,3"/>
    </Style></Grid.Resources>
    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="94"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="기호" Style="{StaticResource MarkerCell}" FontWeight="SemiBold"/>
    <TextBlock Grid.Column="1" Text="역할" Style="{StaticResource MarkerCell}" FontWeight="SemiBold"/>
    <TextBlock Grid.Column="2" Text="본문 입력 예시" Style="{StaticResource MarkerCell}" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="#태그" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="1" Grid.Column="1" Text="분류 · 검색" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="#상담 #마감" Style="{StaticResource MarkerCell}" Foreground="#17617B"/>
    <TextBlock Grid.Row="2" Text="@출처" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="2" Grid.Column="1" Text="자료 출처" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="2" Grid.Column="2" Text="@교무부" Style="{StaticResource MarkerCell}" Foreground="#17617B"/>
    <TextBlock Grid.Row="3" Text="&gt;링크" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="3" Grid.Column="1" Text="원문 주소" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="3" Grid.Column="2" Text="&gt;https://example.com/" Style="{StaticResource MarkerCell}" Foreground="#17617B"/>
    <TextBlock Grid.Row="4" Text="!날짜" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="4" Grid.Column="1" Text="일정 날짜" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="4" Grid.Column="2" Text="!날짜 2026-11-02" Style="{StaticResource MarkerCell}" Foreground="#17617B"/>
    <TextBlock Grid.Row="5" Text="!시간" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="5" Grid.Column="1" Text="시각 (24시간)" Style="{StaticResource MarkerCell}"/>
    <TextBlock Grid.Row="5" Grid.Column="2" Text="!시간 15:30" Style="{StaticResource MarkerCell}" Foreground="#17617B"/>
   </Grid>
   <TextBlock Text="출처·링크·날짜·시각은 각각 별도 줄의 처음에 입력합니다.&#x0a;#마감은 마감 일정으로 구분합니다. 이메일의 @는 그대로 둡니다." FontSize="10" LineHeight="15" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#9F3E22" Margin="0,5,0,0"/>
  </StackPanel>
 </Grid>
 </ScrollViewer>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Content="저장" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
   <Button Grid.Column="2" Content="취소" IsCancel="True"/>
  </Grid>
 </Grid>
</Window>
