<Window x:Class="MyToDoWidget.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MyToDoWidget.Controls"
 xmlns:local="clr-namespace:MyToDoWidget"
 Title="MyToDo2" Width="390" Height="530" MinWidth="180" MinHeight="84" MaxWidth="2000" MaxHeight="2000"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Icon="Assets/app.ico"
 Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing" Closed="Window_Closed" Deactivated="Window_Deactivated" ContextMenuOpening="Widget_ContextMenuOpening" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.ContextMenu>
  <ContextMenu x:Name="WidgetMenu" Opened="WidgetMenu_Opened" Closed="WidgetMenu_Closed" Background="#F6F9FB" Foreground="#253643" BorderBrush="#BACBD5" BorderThickness="1" Padding="3" FontFamily="Malgun Gothic" FontSize="13">
   <ContextMenu.Template>
    <ControlTemplate TargetType="ContextMenu">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
       <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </ControlTemplate>
   </ContextMenu.Template>
   <ContextMenu.Resources>
    <Style TargetType="MenuItem">
     <Setter Property="Foreground" Value="#253643"/><Setter Property="Background" Value="Transparent"/>
     <Setter Property="Padding" Value="10,3"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="MenuItemChrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
       <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemChrome" Property="Background" Value="#DBF1FB"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuItemChrome" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator">
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Height="1" Margin="6,4" Background="#D9E2E8"/>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </ContextMenu.Resources>
   <MenuItem Header="새 메모 / 일정…" Click="Add_Click"/>
   <MenuItem x:Name="EditMenuItem" Header="선택한 항목 편집…" Click="Edit_Click"/>
   <MenuItem x:Name="CompleteMenuItem" Header="완료" Click="Complete_Click"/>
   <MenuItem x:Name="MoveMenuItem" Header="다른 탭으로 이동" Click="MoveKind_Click"/>
   <MenuItem x:Name="DeleteMenuItem" Header="삭제" Click="Delete_Click"/>
   <Separator/>
   <MenuItem x:Name="CompletedFilterMenuItem" Header="완료 항목 표시" Click="CompletedFilter_Click"/>
   <MenuItem Header="검색 / 완료 항목 보기 (Ctrl+F)" Click="SearchMenu_Click"/>
   <MenuItem x:Name="ResetOrderMenuItem" Header="이 탭 기본 순서로 정렬" Click="ResetOrder_Click" ToolTip="메모는 최신순, 일정은 날짜순으로 돌아갑니다. 동기화하면 다른 PC에도 적용됩니다."/>
   <MenuItem Header="메모 백업 / 가져오기…" Click="Backup_Click"/>
   <Separator/>
   <MenuItem x:Name="SyncMenuItem" Header="지금 동기화 (F5)" Click="Refresh_Click"/>
   <MenuItem x:Name="SettingsMenuItem" Header="설정…" Click="Settings_Click"/>
   <MenuItem Header="구글 시트 열기" Click="Sheets_Click"/>
   <MenuItem x:Name="NoteAppMenuItem" Header="메모 앱 열기" Click="NoteApp_Click"/>
   <Separator/>
   <MenuItem x:Name="CopyMenuItem" Header="선택한 메모 복사" Click="Copy_Click"/>
   <Separator/>
   <MenuItem Header="프로그램 종료" Click="Exit_Click" ToolTip="메모와 미전송 변경은 이 PC에 보관됩니다. PC를 옮기기 전에는 지금 동기화를 눌러 주세요."/>
  </ContextMenu>
 </Window.ContextMenu>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <local:PreviewHeightConverter x:Key="PreviewHeight"/>
  <local:LineHeightConverter x:Key="MemoLineHeight"/>
  <local:CardFillConverter x:Key="CardFill"/>
  <local:HeaderWrapConverter x:Key="HeaderWrap"/>
  <Style x:Key="MemoText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="FontFamily" Value="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource MemoText}"><Setter Property="FontSize" Value="11"/><Setter Property="Opacity" Value="0.8"/></Style>
  <Style x:Key="SummaryText" TargetType="TextBlock" BasedOn="{StaticResource MemoText}">
   <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="4,2"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
  </Style>
  <Style x:Key="BubbleAction" TargetType="Button" BasedOn="{StaticResource SmallAction}">
   <Setter Property="Width" Value="{DynamicResource CardActionWidth}"/><Setter Property="Height" Value="20"/><Setter Property="Padding" Value="2"/>
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontStyle" Value="Normal"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ActionChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardIcon" TargetType="Path">
   <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
   <Setter Property="StrokeThickness" Value="1"/>
   <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
   <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
  <Style x:Key="ModeSegment" TargetType="RadioButton">
   <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="10"/>
   <Setter Property="FontWeight" Value="Normal"/><Setter Property="FontStyle" Value="Normal"/>
   <Setter Property="Foreground" Value="#26323F"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid>
     <Border x:Name="SegmentChrome" Background="{TemplateBinding Background}"/>
     <!-- Explicit text properties keep the global TextBlock style and memo bold setting out of the switch. -->
     <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}"
       HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter TargetName="SegmentChrome" Property="Background" Value="#303030"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ResizeHandle" TargetType="Thumb">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
   <EventSetter Event="DragStarted" Handler="Resize_Started"/>
   <EventSetter Event="DragDelta" Handler="Resize_Delta"/>
   <EventSetter Event="DragCompleted" Handler="Resize_Completed"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="20"/><Setter Property="Height" Value="24"/>
   <Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="3"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Foreground" Value="{DynamicResource BarTextBrush}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="IconChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="IconChrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="IconChrome" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollArrow" TargetType="RepeatButton">
   <Setter Property="Width" Value="16"/><Setter Property="Height" Value="24"/>
   <Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="6"/>
   <Setter Property="Foreground" Value="{DynamicResource BarTextBrush}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Delay" Value="300"/><Setter Property="Interval" Value="70"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
    <Border x:Name="ArrowChrome" Background="{TemplateBinding Background}" CornerRadius="3">
     <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ArrowChrome" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ArrowChrome" Property="Opacity" Value="0.22"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="Transparent">
  <Border x:Name="Surface" CornerRadius="14" BorderThickness="1">
   <Grid>
    <Border x:Name="GlassReflection" CornerRadius="13" IsHitTestVisible="False">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
      <GradientStop Color="#50FFFFFF" Offset="0"/><GradientStop Color="#0CFFFFFF" Offset="0.35"/><GradientStop Color="#00FFFFFF" Offset="1"/>
     </LinearGradientBrush></Border.Background>
    </Border>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="TitleBar" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource HeaderEdgeBrush}" BorderThickness="0,0,0,1" CornerRadius="13,13,0,0" Padding="6,1" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseLeftButtonUp" LostMouseCapture="Header_LostMouseCapture">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid VerticalAlignment="Center" Margin="0,0,4,0" Width="70">
        <Border x:Name="TitleBadge" Background="Transparent" Height="24" ToolTip="끌어서 이동 · 우클릭으로 설정 / 구글 시트 열기">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/app.ico" Width="9.333333" Height="9.333333" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="MyToDo2" FontSize="11" Foreground="{DynamicResource BarTextBrush}" VerticalAlignment="Center"/>
         </StackPanel>
        </Border>
       </Grid>
       <TextBlock x:Name="TimeText" Grid.Column="1" FontFamily="Segoe UI" FontSize="10.5" Foreground="{DynamicResource BarTextBrush}"
         VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" ToolTipService.InitialShowDelay="250"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- A faint highlight over the real title bar follows its color and opacity. -->
        <Border x:Name="ModeSwitch" Width="36" Height="17" Margin="0,0,3,0" Padding="0" Background="#18FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="0" VerticalAlignment="Center">
         <Grid KeyboardNavigation.DirectionalNavigation="Cycle">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <RadioButton x:Name="MemoModeButton" Content="M" Tag="Memo" GroupName="WidgetMode" Style="{StaticResource ModeSegment}" Checked="Mode_Checked" ToolTip="M · 메모" AutomationProperties.Name="메모 보기"/>
          <RadioButton x:Name="ScheduleModeButton" Grid.Column="1" Content="S" Tag="Schedule" GroupName="WidgetMode" Style="{StaticResource ModeSegment}" Checked="Mode_Checked" ToolTip="S · 일정" AutomationProperties.Name="일정 보기"/>
         </Grid>
        </Border>
        <Button x:Name="AddButton" Style="{StaticResource IconButton}" ToolTip="새 메모 / 일정 (Ctrl+N)" AutomationProperties.Name="새 메모 또는 일정" Click="Add_Click">
         <Path Data="M9,3 L9,15 M3,9 L15,9" Width="9.333333" Height="9.333333" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" ToolTip="지금 동기화 (F5) · 기본 30분마다 자동 동기화" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="지금 동기화" Click="Refresh_Click">
         <Path Data="M15,6 A6,6 0 1 0 15,11 M15,2 L15,6 L11,6" Width="9.333333" Height="9.333333" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="0.933333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <Button x:Name="SearchToggleButton" Style="{StaticResource IconButton}" Click="SearchToggle_Click" ToolTip="검색 / 완료 항목 보기 (Ctrl+F)" AutomationProperties.Name="검색 및 완료 항목 필터">
         <Path Data="M10.5,6.5 A4,4 0 1 1 2.5,6.5 A4,4 0 1 1 10.5,6.5 M9.5,9.5 L14,14" Width="9.333333" Height="9.333333" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <Button x:Name="RollToggleButton" Style="{StaticResource IconButton}" ToolTip="롤업 · 말풍선 접기" AutomationProperties.Name="말풍선 접기" Click="RollToggle_Click">
         <Path x:Name="RollToggleIcon" Data="M4,3 L14,3 M4,12 L9,7 L14,12" Width="9.333333" Height="9.333333" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="0.933333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <Button x:Name="HideButton" Style="{StaticResource IconButton}" ToolTip="최소화 · 트레이로 숨기기" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="트레이로 숨기기" Click="Hide_Click">
         <Path Data="M4,12 L14,12" Width="9.333333" Height="9.333333" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="0.933333" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Button>
        <Border x:Name="ScrollDivider" Width="1" Height="8" Background="{DynamicResource HeaderDividerBrush}" Margin="2,0" VerticalAlignment="Center"/>
        <RepeatButton x:Name="ScrollUpButton" Content="▲" Style="{StaticResource ScrollArrow}" IsEnabled="False" Click="ScrollUp_Click" ToolTip="위로 스크롤 · 누르고 있으면 계속 이동" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="메모 위로 스크롤"/>
        <RepeatButton x:Name="ScrollDownButton" Content="▼" Style="{StaticResource ScrollArrow}" IsEnabled="False" Click="ScrollDown_Click" ToolTip="아래로 스크롤 · 누르고 있으면 계속 이동" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="메모 아래로 스크롤"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid x:Name="NoteArea" Grid.Row="1" Margin="4,5,4,10" ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="SearchPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="SearchBox" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Padding="5,1" MinHeight="24" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="본문과 해시태그 검색" ToolTip="단어 또는 #태그 검색 · 여러 단어/태그는 모두 포함하는 항목"/>
       <CheckBox x:Name="CompletedCheck" Grid.Column="1" Content="완료" Margin="6,0,0,0" VerticalAlignment="Center" Checked="CompletedFilter_Changed" Unchecked="CompletedFilter_Changed" ToolTip="완료 항목도 표시"/>
      </Grid>
      <TextBlock x:Name="LocalModeHint" Grid.Row="1" Text="클라우드 연결 전 · 이 PC에만 저장" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,2,6" ToolTip="새 메모와 일정은 이 PC에 저장됩니다. 다른 PC와 공유하려면 우클릭 → 설정 → 시트 연결을 확인하세요."/>
      <ListBox x:Name="NoteList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
        ScrollViewer.CanContentScroll="True" ScrollViewer.PanningMode="VerticalOnly"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1"
        PreviewMouseWheel="NoteList_MouseWheel" PreviewMouseRightButtonDown="NoteList_RightClick"
        PreviewMouseLeftButtonDown="NoteList_PointerDown" PreviewMouseMove="NoteList_PointerMove" PreviewMouseLeftButtonUp="NoteList_PointerUp"
        AllowDrop="True" PreviewDragOver="NoteList_DragOver" PreviewDrop="NoteList_Drop" DragLeave="NoteList_DragLeave"
        AutomationProperties.Name="메모 말풍선 목록">
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
         <Setter Property="Margin" Value="{DynamicResource BubbleSpacing}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent">
           <controls:SpeechBubble x:Name="Bubble" HorizontalAlignment="{DynamicResource BubbleAlignment}"
             Shape="{DynamicResource MemoShape}" TailSide="{DynamicResource MemoTail}" FitContentWidth="{DynamicResource FitMemoContentWidth}"
             Tag="{DynamicResource BubbleOpacity}" Stroke="{DynamicResource BubbleEdgeBrush}"
             ToolTip="{Binding DetailHint}">
            <controls:SpeechBubble.Fill><MultiBinding Converter="{StaticResource CardFill}"><Binding Path="BackgroundColor"/><Binding Path="Tag" RelativeSource="{RelativeSource Self}"/></MultiBinding></controls:SpeechBubble.Fill>
            <ContentPresenter/>
           </controls:SpeechBubble>
          </Grid>
          <ControlTemplate.Triggers>
           <DataTrigger Binding="{Binding IsSchedule}" Value="True">
            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Stretch"/>
            <Setter TargetName="Bubble" Property="FitContentWidth" Value="False"/>
           </DataTrigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Setter.Value></Setter>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Opacity="{Binding ContentOpacity}">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding DateLine}" Style="{StaticResource SmallText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
           MaxWidth="{DynamicResource CardDateWidth}" VerticalAlignment="Center" ToolTip="{Binding DateLine}" Margin="0,0,5,0"
           Visibility="{Binding IsSchedule, Converter={StaticResource BoolVisibility}}"/>
          <controls:TaggedTextBlock Grid.Column="1" ContentText="{Binding HeaderTitle}" TagForeground="{DynamicResource TagTextBrush}" Style="{StaticResource SummaryText}" TextWrapping="{Binding WrapHeader, Converter={StaticResource HeaderWrap}}" TextTrimming="CharacterEllipsis"
           VerticalAlignment="Top" ToolTip="{Binding HeaderTitle}" Margin="0,0,5,0" LineStackingStrategy="BlockLineHeight"
           LineHeight="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource MemoLineHeight}}">
           <controls:TaggedTextBlock.MaxHeight><MultiBinding Converter="{StaticResource PreviewHeight}"><Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="HeaderLines"/></MultiBinding></controls:TaggedTextBlock.MaxHeight>
          </controls:TaggedTextBlock>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
           <Button Style="{StaticResource BubbleAction}" ToolTip="{Binding CompleteHint}" Click="BubbleComplete_Click" AutomationProperties.Name="완료 또는 완료 취소">
            <Path Data="{Binding CompletePath}" Style="{StaticResource CardIcon}"/>
           </Button>
           <Button Style="{StaticResource BubbleAction}" ToolTip="편집" Click="BubbleEdit_Click" AutomationProperties.Name="항목 편집">
            <Path Data="M2,10 L2,14 L6,14 L14,6 L10,2 Z M8,4 L12,8" Style="{StaticResource CardIcon}"/>
           </Button>
           <Button Style="{StaticResource BubbleAction}" ToolTip="위젯에서 숨기기 · 시트에는 보관" Click="BubbleDelete_Click" AutomationProperties.Name="항목 삭제">
            <Path Data="M2,4 L14,4 M6,4 L6,2 L10,2 L10,4 M4,4 L5,14 L11,14 L12,4 M7,6 L7,12 M9,6 L9,12" Style="{StaticResource CardIcon}"/>
           </Button>
           <Button Style="{StaticResource BubbleAction}" ToolTip="{Binding ExpandHint}" Click="BubbleExpand_Click" AutomationProperties.Name="보기 단계 변경: 1줄, 2줄, 전체" IsEnabled="{Binding CanExpand}">
            <Path Data="{Binding ExpandPath}" Style="{StaticResource CardIcon}" Height="8"/>
           </Button>
          </StackPanel>
         </Grid>
         <controls:TaggedTextBlock ContentText="{Binding BodyContent}" TagForeground="{DynamicResource TagTextBrush}" Visibility="{Binding ShowPreview, Converter={StaticResource BoolVisibility}}" Style="{StaticResource MemoText}"
          TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight"
          LineHeight="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource MemoLineHeight}}">
          <controls:TaggedTextBlock.MaxHeight><MultiBinding Converter="{StaticResource PreviewHeight}">
           <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"/><Binding Path="TextLines"/>
          </MultiBinding></controls:TaggedTextBlock.MaxHeight>
         </controls:TaggedTextBlock>
         <StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource BoolVisibility}}">
          <controls:TaggedTextBlock ContentText="{Binding BodyContent}" TagForeground="{DynamicResource TagTextBrush}" Style="{StaticResource MemoText}"/>
          <TextBlock Text="{Binding ReminderLine}" Style="{StaticResource SmallText}" Margin="0,4,0,0" Visibility="{Binding HasReminder, Converter={StaticResource BoolVisibility}}"/>
          <TextBlock Text="{Binding Source, StringFormat='@{0}'}" Style="{StaticResource SmallText}" Margin="0,4,0,0" Visibility="{Binding HasSource, Converter={StaticResource BoolVisibility}}"/>
          <Button Content="링크 열기 ↗" Style="{StaticResource SmallAction}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OriginalLink_Click" Visibility="{Binding HasLink, Converter={StaticResource BoolVisibility}}"/>
         </StackPanel>
         <ItemsControl ItemsSource="{Binding Tags}" Visibility="{Binding HasTags, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Button Style="{StaticResource SmallAction}" FontSize="10" Padding="2,1" Margin="0,0,3,0" Click="Tag_Click" ToolTip="{Binding}">
            <TextBlock Text="{Binding StringFormat='#{0}'}" Foreground="{DynamicResource TagTextBrush}" FontSize="10" MaxWidth="80" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
           </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <TextBlock Text="{Binding Status}" Style="{StaticResource SmallText}" Visibility="{Binding HasStatus, Converter={StaticResource BoolVisibility}}" Margin="0,2,0,0"/>
        </StackPanel>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="DropIndicator" Grid.Row="2" Height="2" VerticalAlignment="Top" Background="#007DA8" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="5"/>
      <Border x:Name="EmptyPanel" Grid.Row="2" VerticalAlignment="Center" Background="{DynamicResource ChromeBrush}" CornerRadius="12" Padding="16">
       <StackPanel>
        <TextBlock x:Name="EmptyTitle" Text="메모를 연결해 주세요" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="EmptyText" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,16"/>
        <Button x:Name="EmptyAddButton" Content="이 PC에 새 메모 / 일정" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Add_Click" Margin="0,0,0,8"/>
        <Button x:Name="EmptySettingsButton" Content="클라우드 연결" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="Settings_Click"/>
       </StackPanel>
      </Border>
     </Grid>
    </Grid>
   </Grid>
  </Border>
  <Grid x:Name="ResizeHandles">
   <Thumb Tag="W" Style="{StaticResource ResizeHandle}" HorizontalAlignment="Left" Width="6" Margin="0,12" Cursor="SizeWE"/>
   <Thumb Tag="E" Style="{StaticResource ResizeHandle}" HorizontalAlignment="Right" Width="6" Margin="0,12" Cursor="SizeWE"/>
   <Thumb Tag="E" Style="{StaticResource ResizeHandle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="SizeWE" ToolTip="끌어서 가로 폭 조절 · 높이는 내용에 맞춰 자동 조절">
    <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M4,11 L11,4 M8,11 L11,8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1"/></Grid></ControlTemplate></Thumb.Template>
   </Thumb>
  </Grid>
 </Grid>
</Window>
