<Window x:Class="MyToDoWidget.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MyToDoWidget.Controls"
 xmlns:core="clr-namespace:MyToDoWidget.Core;assembly=MyToDoWidget.Core"
 Title="MyToDo 설정" Width="520" Height="740" MinWidth="460" MinHeight="520"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="{DynamicResource PanelBrush}" Icon="Assets/app.ico" Closing="Window_Closing">
 <Window.Resources>
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SlimScrollThumb" TargetType="Thumb">
   <Setter Property="MinHeight" Value="26"/><Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Grid Background="Transparent">
     <Border x:Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="4" Margin="3,0"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Margin" Value="2,0"/><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Margin" Value="2,0"/><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SlimVerticalScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}">
     <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
   <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="CanContentScroll" Value="False"/><Setter Property="PanningMode" Value="VerticalOnly"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" ClipToBounds="True"/>
     <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SlimVerticalScrollBar}" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ColorThemeList" TargetType="ListBox">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></Setter.Value></Setter>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="2" Margin="1"><ContentPresenter/></Border>
         <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></Setter.Value></Setter>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
        <Border Background="{Binding BackgroundBrush}" CornerRadius="5" Padding="3,9">
         <TextBlock Text="{Binding Name}" Foreground="{Binding ForegroundBrush}" TextAlignment="Center" FontSize="11"/>
        </Border>
       </DataTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#23313C"/><Setter Property="Background" Value="White"/>
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,4"/>
   <Setter Property="MaxDropDownHeight" Value="240"/><Setter Property="IsTextSearchEnabled" Value="True"/>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#23313C"/><Setter Property="Background" Value="White"/></Style>
  <DataTemplate x:Key="ChoiceItemTemplate">
   <TextBlock Text="{Binding Label}" Foreground="#23313C"/>
  </DataTemplate>
  <Style x:Key="GuideHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Margin" Value="0,14,0,6"/>
  </Style>
  <Style x:Key="GuideBody" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="LineHeight" Value="19"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Padding="9,8" CornerRadius="8,8,0,0" Background="{DynamicResource TabBrush}" Margin="0,0,3,0">
     <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
     <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TabPanel IsItemsHost="True"/>
     <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="12">
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="PreviewPanel" Margin="0,0,0,14">
   <TextBlock Text="말풍선 미리보기" FontSize="16" FontWeight="SemiBold"/>
   <Border x:Name="SampleSurface" Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="10" Margin="0,9,0,6" MinHeight="84">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}" MaxHeight="180">
     <StackPanel>
      <controls:SpeechBubble x:Name="SampleBubble" HorizontalAlignment="Left">
       <TextBlock x:Name="SampleText" Text="메모 미리보기 Aa 123" TextWrapping="Wrap"/>
      </controls:SpeechBubble>
      <controls:SpeechBubble x:Name="SampleBubbleNext" HorizontalAlignment="Left">
       <TextBlock x:Name="SampleTextNext" Text="다음 메모" TextWrapping="Wrap"/>
      </controls:SpeechBubble>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <TextBlock Text="바꾸면 위젯에도 바로 표시됩니다. 취소하면 원래대로 돌아갑니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl x:Name="EditorPanel" Grid.Row="1" SelectionChanged="EditorPanel_SelectionChanged">
   <TabItem x:Name="BubbleTab" Header="말풍선">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="모양" Margin="0,0,0,6"/><ComboBox x:Name="ShapeCombo" ItemTemplate="{StaticResource ChoiceItemTemplate}" TextSearch.TextPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 모양"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="꼬리" Margin="0,0,0,6"/><ComboBox x:Name="TailCombo" ItemTemplate="{StaticResource ChoiceItemTemplate}" TextSearch.TextPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 꼬리"/></StackPanel>
      </Grid>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="정렬" Margin="0,0,0,6"/><ComboBox x:Name="AlignmentCombo" ItemTemplate="{StaticResource ChoiceItemTemplate}" TextSearch.TextPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 정렬"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="가로 폭" Margin="0,0,0,6"/><ComboBox x:Name="WidthModeCombo" ItemTemplate="{StaticResource ChoiceItemTemplate}" TextSearch.TextPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 가로 폭"/></StackPanel>
      </Grid>
      <TextBlock x:Name="LayoutHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
      <Grid><TextBlock Text="말풍선 사이 간격"/><TextBlock x:Name="GapValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="GapSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,4" ValueChanged="Slider_Changed" AutomationProperties.Name="말풍선 수직 간격"/>
      <Grid Margin="0,0,0,14"><TextBlock Text="0 · 붙이기" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="40 · 넓게" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <TextBlock Text="파스텔 테마" Margin="0,0,0,7"/>
      <ListBox x:Name="ThemeList" Style="{StaticResource ColorThemeList}" SelectionChanged="Theme_Changed" AutomationProperties.Name="파스텔 테마"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="배경색" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button Padding="5" Margin="0,0,6,0" MinHeight="30" Click="BackgroundColor_Click" ToolTip="말풍선 배경색 선택" AutomationProperties.Name="말풍선 배경색 선택">
          <Border x:Name="BackgroundSwatch" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"/>
         </Button>
         <TextBox x:Name="BackgroundHex" Grid.Column="1" MaxLength="7" FontSize="12" TextChanged="ColorText_Changed" AutomationProperties.Name="말풍선 배경색 HEX"/>
        </Grid>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="글자색" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button Padding="5" Margin="0,0,6,0" MinHeight="30" Click="TextColor_Click" ToolTip="메모 글자색 선택" AutomationProperties.Name="메모 글자색 선택">
          <Border x:Name="TextSwatch" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"/>
         </Button>
         <TextBox x:Name="TextHex" Grid.Column="1" MaxLength="7" FontSize="12" TextChanged="ColorText_Changed" AutomationProperties.Name="메모 글자색 HEX"/>
        </Grid>
       </StackPanel>
      </Grid>
      <TextBlock Text="색상 칸을 누르거나 #RRGGBB로 입력합니다. 테마는 두 색을 함께 바꿉니다." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
      <Grid><TextBlock Text="말풍선 불투명도"/><TextBlock x:Name="BubbleOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="BubbleOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,4" ValueChanged="Slider_Changed" AutomationProperties.Name="말풍선 배경 불투명도" ToolTip="말풍선 배경만 조절합니다. 상단바 배경과 흰색 테두리는 유리판 탭에서 따로 조절합니다."/>
      <Grid Margin="0,0,0,14"><TextBlock Text="0% 완전 투명" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <TextBlock Text="글자·아이콘의 선명도는 유지하고 배경의 불투명도만 조절합니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="글꼴" Margin="0,0,0,6"/>
        <ComboBox x:Name="FontCombo" TextSearch.TextPath="DisplayName" SelectedValuePath="FamilyName" SelectionChanged="Choice_Changed" AutomationProperties.Name="메모 글꼴" ToolTip="{Binding SelectedValue, RelativeSource={RelativeSource Self}}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#23313C" TextTrimming="CharacterEllipsis" MaxWidth="300"/></DataTemplate></ComboBox.ItemTemplate>
         <ComboBox.GroupStyle><GroupStyle>
          <GroupStyle.HeaderTemplate><DataTemplate>
           <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#17617B" Background="#E4F4FB" Padding="6,6"/>
          </DataTemplate></GroupStyle.HeaderTemplate>
         </GroupStyle></ComboBox.GroupStyle>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <Grid Margin="0,0,0,6"><TextBlock Text="기준 크기"/><TextBlock x:Name="FontValue" HorizontalAlignment="Right"/></Grid>
        <Slider x:Name="FontSlider" Minimum="11" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Height="30" VerticalAlignment="Center" ValueChanged="Slider_Changed" AutomationProperties.Name="메모 글자 크기"/>
       </StackPanel>
      </Grid>
      <CheckBox x:Name="ScaleTextCheck" Content="창 크기에 맞춰 메모 글자 확대·축소" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
      <TextBlock x:Name="FontScaleHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
      <TextBlock x:Name="FontHint" Text="한글 고정폭 추천 → 한글 지원 → 영문 중심 순서입니다." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <CheckBox x:Name="BoldCheck" Content="굵게" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
       <CheckBox x:Name="ItalicCheck" Content="기울임" Margin="20,8,0,0" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="GlassTab" Header="유리판">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="유리판 배경색" Margin="0,0,0,7"/>
      <ListBox x:Name="GlassThemeList" Style="{StaticResource ColorThemeList}" SelectionChanged="GlassTheme_Changed" AutomationProperties.Name="유리판 색상 테마"/>
      <Grid Margin="0,10,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Padding="5" Margin="0,0,6,0" MinHeight="30" Click="GlassColor_Click" ToolTip="유리판 배경색 선택" AutomationProperties.Name="유리판 배경색 선택">
        <Border x:Name="GlassSwatch" Width="16" Height="16" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"/>
       </Button>
       <TextBox x:Name="GlassHex" Grid.Column="1" MaxLength="7" TextChanged="GlassColorText_Changed" AutomationProperties.Name="유리판 배경색 HEX"/>
       <Button Grid.Column="2" Content="기본색" Margin="8,0,0,0" Padding="10,5" Click="GlassReset_Click" ToolTip="유리판의 기본색으로 되돌리기"/>
      </Grid>
      <TextBlock x:Name="GlassColorHint" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/>
      <Grid><TextBlock Text="유리판 불투명도"/><TextBlock x:Name="GlassOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="GlassOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,6" ValueChanged="Slider_Changed" AutomationProperties.Name="유리판 불투명도"/>
      <Grid><TextBlock Text="0% 완전 투명" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <Grid Margin="0,18,0,0"><TextBlock Text="상단바 배경 불투명도"/><TextBlock x:Name="HeaderOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="HeaderOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,6" ValueChanged="Slider_Changed" AutomationProperties.Name="상단바 배경 불투명도"/>
      <Grid><TextBlock Text="0% 완전 투명" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <Grid Margin="0,18,0,0"><TextBlock Text="흰색 테두리 불투명도"/><TextBlock x:Name="BorderOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="BorderOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,6" ValueChanged="Slider_Changed" AutomationProperties.Name="흰색 테두리 불투명도"/>
      <Grid><TextBlock Text="0% 숨김" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <TextBlock Text="유리판·상단바 배경·흰색 테두리를 각각 조절합니다. 제목과 버튼은 선명하게 유지합니다." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,10"/>
      <TextBlock Text="환경설정창은 밝은 테마로 표시됩니다. 유리판 색상은 위에서 따로 선택하세요." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/>
      <CheckBox x:Name="GlassCheck" Content="유리판에 은은한 빛 반사" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="ConnectionTab" Header="연결·동작">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}">
     <StackPanel Margin="0,0,8,0">
      <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold" FontSize="15"/>
      <TextBlock Text="저장된 주소는 표시하지 않습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
      <Border Background="#FFF5DF" BorderBrush="#E9C484" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
       <StackPanel>
        <TextBlock Text="민감한 메모 입력 비권장" Foreground="#704515" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="{x:Static core:SheetSource.PrivacyWarning}" Foreground="#704515" FontSize="12" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <TextBlock Text="새 주소 등록 / 교체" Margin="0,0,0,7"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <PasswordBox x:Name="NewAddressBox" MaxLength="8192" PasswordChanged="Address_Changed" AutomationProperties.Name="새 Google Sheets 공유 주소"/>
       <Button Grid.Column="1" Content="붙여넣기" Margin="8,0,0,0" Click="Paste_Click"/>
      </Grid>
      <TextBlock Text="‘링크가 있는 모든 사용자 · 뷰어’로 설정한 일반 공유 주소를 입력하세요. 메모 탭을 연 브라우저 주소도 사용할 수 있습니다.&#x0a;빈칸으로 저장하면 기존 연결을 유지합니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
      <Button x:Name="RemoveButton" Content="연결 해제" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,18" Click="Remove_Click"/>
      <CheckBox x:Name="TopmostCheck" Content="항상 위에 표시"/>
      <CheckBox x:Name="LockCheck" Content="위치와 크기 잠금"/>
      <CheckBox x:Name="StartWithWindowsCheck" Content="Windows 시작 시 자동 실행"/>
      <TextBlock x:Name="StartWithWindowsHint" Text="저장하면 현재 Windows 계정에 적용됩니다. 기본값은 꺼짐입니다.&#x0a;Windows의 시작 앱에서 차단했다면 그곳에서도 사용으로 바꿔 주세요." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="20,5,0,8"/>
      <CheckBox x:Name="StartupCheck" Content="실행할 때 한 번 새로고침"/>
      <TextBlock Text="위젯 우클릭: 설정 / 구글 시트 열기&#x0a;말풍선 더블클릭: 구글 시트 목록 열기&#x0a;접기·펼치기: 상태에 따라 아이콘이 바뀌는 버튼&#x0a;상단 ▲ ▼: 스크롤, 길게 누르면 연속 이동&#x0a;최소화: 위젯을 트레이로 숨기기" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,20,0,0"/>
      <Button Content="간편 설정 및 사용법 보기" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ShowGuide_Click"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="GuideTab" Header="간편 설정 및 사용법">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}">
     <StackPanel Margin="0,0,8,0">
      <TextBlock Text="구글 시트 연결, 한 번만 설정하세요" Style="{StaticResource GuideHeading}" Margin="0,0,0,8"/>
      <TextBlock Text="메모는 구글 시트에서 작성하고, 위젯에서는 새로고침 한 번으로 확인합니다." Style="{StaticResource GuideBody}"/>
      <Border Background="#FFF5DF" BorderBrush="#E9C484" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
       <TextBlock Text="{x:Static core:SheetSource.PrivacyWarning}" Foreground="#704515" FontSize="12" TextWrapping="Wrap"/>
      </Border>
      <WrapPanel Margin="0,2,0,2">
       <Button Content="구글 시트 열기" Padding="10,6" Margin="0,0,6,6" Click="GuideSheets_Click"/>
       <Button Content="CSV 템플릿 저장" Padding="10,6" Margin="0,0,6,6" Click="SaveTemplate_Click"/>
       <Button Content="연결 설정으로" Padding="10,6" Margin="0,0,0,6" Click="GoToConnection_Click"/>
      </WrapPanel>
      <TextBlock x:Name="GuideFeedback" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
      <TextBlock Text="1. 메모 시트 준비" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="메모 전용 스프레드시트 파일을 만듭니다. 위 버튼으로 CSV 템플릿을 저장한 뒤, 시트의 파일 → 가져오기 → 업로드에서 선택하면 예시가 들어갑니다. 공유 권한은 파일 전체에 적용되므로 다른 개인정보를 같은 파일에 넣지 마세요." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="2. A열에 자유롭게 작성" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="A열을 선택해 서식 → 숫자 → 일반 텍스트로 지정합니다. A1부터 셀 하나에 메모 하나를 적고 제목 행은 만들지 않습니다. 셀 안 줄바꿈은 Alt+Enter입니다. 날짜·기호·여러 줄을 그대로 적을 수 있습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="템플릿을 가져올 때 숫자·날짜·수식으로 자동 변환하는 옵션이 보이면 해제하세요. B열 이후의 내용과 시트의 글꼴·색상은 위젯에 표시되지 않습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="3. 링크가 있는 모든 사용자 · 뷰어" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="시트 오른쪽 위의 공유 → 일반 액세스에서 ‘링크가 있는 모든 사용자’를 선택하고 권한을 ‘뷰어’로 설정합니다. 완료 후 링크를 복사하세요. ‘웹에 게시’는 필요하지 않습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="여러 탭이 있으면 메모 탭을 연 뒤 브라우저 주소를 복사하세요. 탭 번호가 없는 공유 링크는 첫 탭을 읽습니다. 위젯이 A열만 표시해도 링크를 아는 사람의 파일 열람 범위가 A열로 제한되지는 않습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="4. 위젯에 주소 등록" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="‘연결 설정으로’를 누르고 새 주소 입력란에 일반 공유 주소를 붙여넣은 뒤 아래의 저장을 누릅니다. 연결을 확인하면 메모가 나타납니다. 저장된 주소는 다시 표시하지 않고 등록 여부만 보여 줍니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="5. 수정 후 새로고침" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="시트에서 메모를 수정한 뒤 위젯의 새로고침 또는 F5를 누릅니다. 다른 컴퓨터에서도 같은 일반 공유 주소를 한 번 등록하면 됩니다. 위젯에서 Google 계정으로 로그인할 필요는 없습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="Windows 시작 시 자동 실행" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="연결·동작에서 ‘Windows 시작 시 자동 실행’을 켜고 저장하세요. 현재 Windows 계정으로 로그인할 때 위젯이 열립니다. 새 메모도 불러오려면 ‘실행할 때 한 번 새로고침’을 함께 켜세요. EXE를 옮긴 뒤 새 위치에서 한 번 실행하면 기존 등록 경로를 갱신합니다. 해제하려면 옵션을 끄고 저장하세요." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="이렇게 활용하세요" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="• 오늘 할 일: 셀마다 준비물·확인할 일을 하나씩 적기&#x0a;• 자유로운 날짜 메모: ‘10/2 오후’, ‘다음 주 중’처럼 적기&#x0a;• 긴 내용: 한 셀 안에서 여러 줄로 정리하기&#x0a;• 여러 컴퓨터: 같은 시트를 연결해 필요할 때 새로고침하기" Style="{StaticResource GuideBody}"/>
      <TextBlock Text="날짜·todo·done은 일반 글자로 표시합니다. 자동 정렬이나 완료 처리 기능은 제공하지 않습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="위젯 조작" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="• 우클릭: 설정 / 구글 시트 열기 / 선택한 메모 복사&#x0a;• 말풍선 더블클릭: 브라우저의 구글 시트 목록 열기&#x0a;• 휠 또는 ▲ ▼: 메모 스크롤&#x0a;• 상단 끌기 / 가장자리 끌기: 이동 / 크기 조절&#x0a;• 접기·펼치기: 본문만 접기 / 이전 높이로 복원&#x0a;• 최소화: 트레이로 숨기기, 트레이 더블클릭으로 복원" Style="{StaticResource GuideBody}"/>
      <TextBlock Text="말풍선 꾸미기" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="말풍선 탭에서 왼쪽·가운데·오른쪽 정렬, 가로 폭과 간격을 고릅니다. ‘내용에 맞춤’은 짧은 메모를 작게 표시하고, ‘위젯 폭에 맞춤’은 모든 말풍선의 폭을 같게 맞춥니다. 꼬리 방향은 정렬과 별도로 선택합니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="연결이 안 되거나 내용이 늦게 바뀐다면" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="‘링크가 있는 모든 사용자 · 뷰어’, 메모 탭 주소와 A열을 확인하세요. 브라우저 로그아웃 상태에서도 시트를 볼 수 있어야 합니다. 다운로드 제한이나 조직 계정의 외부 공유 정책 때문에 연결되지 않을 수도 있습니다. 연결 실패 시 마지막 정상 메모를 유지합니다." Style="{StaticResource GuideBody}"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="AboutTab" Header="정보">
    <ScrollViewer Style="{StaticResource SettingsScrollViewer}">
     <StackPanel Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
       <Image Source="{StaticResource AboutAppIcon}" Width="40" Height="40" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="MyToDo 아이콘"/>
       <StackPanel><TextBlock Text="MyToDo" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
      </StackPanel>
      <TextBlock Text="구글 시트의 자유 메모를 바탕화면에서 읽는 작은 위젯입니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="공식 배포 페이지" Style="{StaticResource GuideHeading}"/>
      <TextBlock x:Name="OfficialAddressText" Style="{StaticResource GuideBody}"/>
      <Button Content="공식 배포 페이지 열기" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OfficialPage_Click"/>
      <TextBlock Text="제작: MathTime&#x0a;라이선스: MIT&#x0a;© 2026 MathTime" Style="{StaticResource GuideBody}" Margin="0,18,0,12"/>
      <TextBlock Text="연결과 보관" Style="{StaticResource GuideHeading}"/>
      <TextBlock Text="위젯은 공유된 시트의 CSV를 읽으며 시트를 수정하거나 Google 로그인 정보를 저장하지 않습니다. 시트 작성·수정에 필요한 로그인은 브라우저에서 관리합니다. 연결 주소와 마지막 메모는 Windows 사용자별로 암호화해 보관하며, 이는 Google Sheets의 공유 권한을 바꾸지 않습니다." Style="{StaticResource GuideBody}"/>
      <TextBlock Text="{x:Static core:SheetSource.PrivacyWarning}" Style="{StaticResource GuideBody}"/>
      <Button Content="간편 설정 및 사용법 보기" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ShowGuide_Click"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap" Foreground="#9F3E22" Margin="0,10,0,10"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="SaveButton" Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
   <Button x:Name="CancelButton" Grid.Column="2" Content="취소" IsCancel="True"/>
  </Grid>
 </Grid>
</Window>
