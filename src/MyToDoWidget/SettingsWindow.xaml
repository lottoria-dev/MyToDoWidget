<Window x:Class="MyToDoWidget.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:MyToDoWidget.Controls"
 Title="MyToDo 설정" Width="520" Height="740" MinWidth="460" MinHeight="520"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="{DynamicResource PanelBrush}" Icon="Assets/app.ico" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Padding" Value="8,6"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#23313C"/><Setter Property="Background" Value="White"/>
   <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6,4"/>
   <Setter Property="MaxDropDownHeight" Value="240"/><Setter Property="IsTextSearchEnabled" Value="True"/>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#23313C"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" Padding="16,9" CornerRadius="8,8,0,0" Background="{DynamicResource CardBrush}" Margin="0,0,3,0">
     <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
     <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
     <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TabPanel IsItemsHost="True"/>
     <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="12">
      <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14">
   <TextBlock Text="말풍선 미리보기" FontSize="16" FontWeight="SemiBold"/>
   <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="10" Margin="0,9,0,6" MinHeight="84">
    <controls:SpeechBubble x:Name="SampleBubble" HorizontalAlignment="Left">
     <TextBlock x:Name="SampleText" Text="메모 미리보기 Aa 123" TextWrapping="Wrap"/>
    </controls:SpeechBubble>
   </Border>
   <TextBlock Text="바꾸면 위젯에도 바로 표시됩니다. 취소하면 원래대로 돌아갑니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl x:Name="EditorPanel" Grid.Row="1">
   <TabItem Header="말풍선">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,8,0">
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="모양" Margin="0,0,0,6"/><ComboBox x:Name="ShapeCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 모양"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="꼬리" Margin="0,0,0,6"/><ComboBox x:Name="TailCombo" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Choice_Changed" AutomationProperties.Name="말풍선 꼬리"/></StackPanel>
      </Grid>
      <TextBlock Text="파스텔 테마" Margin="0,0,0,7"/>
      <ListBox x:Name="ThemeList" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="Theme_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="파스텔 테마">
       <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Selection" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" Padding="2" Margin="1"><ContentPresenter/></Border>
         <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Border Background="{Binding BackgroundBrush}" CornerRadius="5" Padding="3,9">
         <TextBlock Text="{Binding Name}" Foreground="{Binding ForegroundBrush}" TextAlignment="Center" FontSize="11"/>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="배경색" VerticalAlignment="Center"/>
       <Border x:Name="BackgroundSwatch" Grid.Column="1" CornerRadius="5" Margin="0,3,6,3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"/>
       <TextBox x:Name="BackgroundHex" Grid.Column="2" MaxLength="7" TextChanged="ColorText_Changed" AutomationProperties.Name="말풍선 배경색 HEX"/>
       <Button Grid.Column="3" Content="색상…" Margin="8,0,0,0" Click="BackgroundColor_Click"/>
      </Grid>
      <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="글자색" VerticalAlignment="Center"/>
       <Border x:Name="TextSwatch" Grid.Column="1" CornerRadius="5" Margin="0,3,6,3" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"/>
       <TextBox x:Name="TextHex" Grid.Column="2" MaxLength="7" TextChanged="ColorText_Changed" AutomationProperties.Name="메모 글자색 HEX"/>
       <Button Grid.Column="3" Content="색상…" Margin="8,0,0,0" Click="TextColor_Click"/>
      </Grid>
      <TextBlock Text="#RRGGBB 직접 입력 또는 색상 선택. 테마를 고르면 배경색과 글자색이 함께 바뀝니다." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
      <Grid><TextBlock Text="말풍선 배경 불투명도"/><TextBlock x:Name="BubbleOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="BubbleOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,4" ValueChanged="Slider_Changed" AutomationProperties.Name="말풍선 배경 불투명도"/>
      <Grid Margin="0,0,0,14"><TextBlock Text="0% 완전 투명" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <TextBlock Text="글꼴" Margin="0,0,0,6"/>
      <ComboBox x:Name="FontCombo" SelectionChanged="Choice_Changed" AutomationProperties.Name="메모 글꼴"/>
      <Grid Margin="0,12,0,0"><TextBlock Text="글자 크기"/><TextBlock x:Name="FontValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="FontSlider" Minimum="11" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="Slider_Changed" AutomationProperties.Name="메모 글자 크기"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <CheckBox x:Name="BoldCheck" Content="굵게" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
       <CheckBox x:Name="ItalicCheck" Content="기울임" Margin="20,8,0,0" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="유리판">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,8,0">
      <Grid><TextBlock Text="유리판 불투명도"/><TextBlock x:Name="GlassOpacityValue" HorizontalAlignment="Right"/></Grid>
      <Slider x:Name="GlassOpacitySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,6" ValueChanged="Slider_Changed" AutomationProperties.Name="유리판 불투명도"/>
      <Grid><TextBlock Text="0% 완전 투명" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="100% 완전 불투명" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
      <TextBlock Text="유리판과 말풍선 배경을 따로 조절합니다. 글자에는 불투명도가 적용되지 않습니다." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,10"/>
      <CheckBox x:Name="LightThemeCheck" Content="밝은 테마" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
      <CheckBox x:Name="GlassCheck" Content="유리판에 은은한 빛 반사" Checked="Appearance_Changed" Unchecked="Appearance_Changed"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="연결·동작">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,8,0">
      <TextBlock x:Name="ConnectionStatus" FontWeight="SemiBold" FontSize="15"/>
      <TextBlock Text="저장된 주소는 표시하지 않습니다." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14"/>
      <TextBlock Text="새 주소 등록 / 교체" Margin="0,0,0,7"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <PasswordBox x:Name="NewAddressBox" MaxLength="8192" PasswordChanged="Address_Changed" AutomationProperties.Name="새 CSV 게시 주소"/>
       <Button Grid.Column="1" Content="붙여넣기" Margin="8,0,0,0" Click="Paste_Click"/>
      </Grid>
      <TextBlock Text="‘웹에 게시’의 CSV 주소를 입력하세요.&#x0a;빈칸으로 저장하면 기존 연결을 유지합니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
      <Button x:Name="RemoveButton" Content="연결 해제" HorizontalAlignment="Left" Padding="10,5" Margin="0,12,0,18" Click="Remove_Click"/>
      <CheckBox x:Name="TopmostCheck" Content="항상 위에 표시"/>
      <CheckBox x:Name="LockCheck" Content="위치와 크기 잠금"/>
      <CheckBox x:Name="StartupCheck" Content="실행할 때 한 번 새로고침"/>
      <TextBlock Text="말풍선 더블클릭: 구글 시트 목록 열기&#x0a;롤업 / 롤다운: 말풍선 접기 / 펼치기&#x0a;최소화: 위젯을 트레이로 숨기기" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,20,0,0"/>
      <TextBlock Text="MyToDo 0.3.0" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,20,0,6"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap" Foreground="#D98565" Margin="0,10,0,10"/>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="SaveButton" Content="저장" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
   <Button x:Name="CancelButton" Grid.Column="2" Content="취소" IsCancel="True"/>
  </Grid>
 </Grid>
</Window>
