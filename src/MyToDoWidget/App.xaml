<Application x:Class="MyToDoWidget.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <!-- Vector artwork for the About tab; scales at the current monitor DPI. -->
  <DrawingImage x:Key="AboutAppIcon">
   <DrawingImage.Drawing>
    <DrawingGroup>
     <GeometryDrawing Brush="#245B54">
      <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12"/></GeometryDrawing.Geometry>
     </GeometryDrawing>
     <GeometryDrawing Brush="#DFF6EB" Geometry="M 13,8 L 30,8 L 37,15 L 37,36 Q 37,40 33,40 L 13,40 Q 9,40 9,36 L 9,12 Q 9,8 13,8 Z"/>
     <GeometryDrawing Brush="#A4D8C6" Geometry="M 30,8 L 30,15 L 37,15 Z"/>
     <GeometryDrawing Brush="#245B54">
      <GeometryDrawing.Geometry>
       <GeometryGroup>
        <RectangleGeometry Rect="15,18,15,2" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="15,24,11,2" RadiusX="1" RadiusY="1"/>
        <RectangleGeometry Rect="15,30,7,2" RadiusX="1" RadiusY="1"/>
       </GeometryGroup>
      </GeometryDrawing.Geometry>
     </GeometryDrawing>
     <GeometryDrawing Brush="#00A0D7">
      <GeometryDrawing.Geometry><EllipseGeometry Center="35,35" RadiusX="10" RadiusY="10"/></GeometryDrawing.Geometry>
     </GeometryDrawing>
     <GeometryDrawing Geometry="M 30,35 L 33.5,38.5 L 40,31.5">
      <GeometryDrawing.Pen><Pen Brush="White" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
     </GeometryDrawing>
    </DrawingGroup>
   </DrawingImage.Drawing>
  </DrawingImage>

  <SolidColorBrush x:Key="TextBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="MutedBrush" Color="#ADBACB" />
  <SolidColorBrush x:Key="CardBrush" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="BubbleBrush" Color="#30443E" />
  <SolidColorBrush x:Key="BubbleEdgeBrush" Color="#5076A28F" />
  <SolidColorBrush x:Key="GlassEdgeBrush" Color="#50FFFFFF" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#E6202937" />
  <SolidColorBrush x:Key="LineBrush" Color="#25FFFFFF" />
  <SolidColorBrush x:Key="PanelBrush" Color="#202937" />
  <SolidColorBrush x:Key="FieldBrush" Color="#14202D" />
  <SolidColorBrush x:Key="AccentBrush" Color="#00A0D7" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TabBrush" Color="#21485D" />
  <SolidColorBrush x:Key="TabTextBrush" Color="#C6ECFC" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7C91A2" />
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Malgun Gothic" />
   <Setter Property="FontSize" Value="13" />
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
   <Setter Property="UseLayoutRounding" Value="True" />
   <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#263542"/><Setter Property="Foreground" Value="#F8FAFC"/>
   <Setter Property="BorderBrush" Value="#637786"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="8,3"/><Setter Property="MaxWidth" Value="360"/>
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <TextBlock Text="{Binding}" Foreground="#F8FAFC" FontFamily="Malgun Gothic" FontSize="12" TextWrapping="Wrap"/>
   </DataTemplate></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter ContentSource="Content"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
   <Setter Property="Background" Value="{DynamicResource CardBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="Padding" Value="10,3" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="MinHeight" Value="26" />
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.58" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
   <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
   <Setter Property="BorderThickness" Value="0" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
   <Setter Property="Margin" Value="0,4,0,0" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
   <Setter Property="Padding" Value="8,1" />
   <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- One-line form controls share a compact height and vertical content alignment.
       Window-local implicit styles opt into these; the multiline body overrides it. -->
  <Style x:Key="FormTextBox" TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FormPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
   <Setter Property="Padding" Value="7,1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FormComboBox" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#23313C"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="Padding" Value="7,1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="MaxDropDownHeight" Value="240"/>
   <Setter Property="IsTextSearchEnabled" Value="True"/>
  </Style>
  <Style x:Key="FormComboBoxItem" TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#23313C"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Padding" Value="7,1"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FormDatePicker" TargetType="DatePicker">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
    <Grid x:Name="PART_Root" SnapsToDevicePixels="True">
     <Border x:Name="FormDateBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
       <!-- Explicit alignment is necessary: native templates can set Stretch locally. -->
       <primitives:DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
        Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0"
        FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
        Padding="7,0" MinHeight="0" MinWidth="0" VerticalAlignment="Stretch"
        VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
        Focusable="{TemplateBinding Focusable}"/>
       <!-- Isolate the calendar toggle from the application's large action-button style. -->
       <Button x:Name="PART_Button" Grid.Column="1" Style="{x:Null}" MinHeight="0" MinWidth="0"
        Padding="0" Margin="0" Focusable="False" Background="Transparent" BorderThickness="0"
        Foreground="{TemplateBinding Foreground}" VerticalAlignment="Stretch"
        VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Cursor="Hand"
        ToolTip="달력 열기" AutomationProperties.Name="달력 열기">
        <Button.Template><ControlTemplate TargetType="Button">
         <Border x:Name="FormCalendarChrome" Background="{TemplateBinding Background}" CornerRadius="3" Margin="2">
          <Path Data="M2,4 L14,4 L14,14 L2,14 Z M2,7 L14,7 M5,2 L5,5 M11,2 L11,5"
           Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
           Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FormCalendarChrome" Property="Background" Value="#E2F3FB"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="FormCalendarChrome" Property="Background" Value="#C9EAF9"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
       </Button>
      </Grid>
     </Border>
     <!-- DatePicker installs and manages its native Calendar in this named popup. -->
     <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" StaysOpen="False" AllowsTransparency="True" Focusable="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FormDateBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_Root" Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Padding" Value="8,3"/>
   <Setter Property="MinHeight" Value="24"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
 </Application.Resources>
</Application>
